# Copy to .env.local for development, and set the same keys in the Vercel
# project for production. Everything here is safe to expose in the browser —
# the anon key is designed to be public and is what row level security is
# written against.
#
# The service_role key must NEVER appear in this file or anywhere in the client.
# It bypasses RLS entirely and belongs only in Supabase Edge Function secrets.

# The domain onboarding links are built from. Without it, a generated link
# carries whatever origin the browser happens to be on — including localhost.
VITE_PUBLIC_APP_URL=https://mobiles.vercel.app

# Supabase project — Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
